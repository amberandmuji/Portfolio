---
import { nav, site } from '../data/site';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="hdr" data-header>
  <div class="hdr-in">
    <a href="/" class="brand" aria-label={`${site.name} — home`}>
      {site.name}
    </a>

    <nav class="links" aria-label="Main">
      {nav.map((n) => (
        <a
          href={n.href}
          class:list={['link', { active: path === n.href }]}
          {...(n.external ? { target: '_blank', rel: 'noopener' } : {})}
        ><span class="label">{n.label}</span></a>
      ))}
    </nav>

    <button class="burger" aria-expanded="false" aria-controls="menu" data-menu-toggle>
      <span class="sr">Menu</span>
      <span class="bar"></span><span class="bar"></span>
    </button>
  </div>

  <div class="menu" id="menu" data-menu hidden>
    <h4 class="sr">Menu</h4>
    {nav.map((n, i) => (
      <a href={n.href} style={`--i:${i}`} {...(n.external ? { target: '_blank', rel: 'noopener' } : {})}>{n.label}</a>
    ))}
  </div>
</header>

<style>
  .hdr {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid transparent;
    transition: transform var(--dur-2) var(--ease-out), border-color var(--dur-2);
  }
  .hdr.scrolled { border-bottom-color: var(--line); }
  .hdr.hide { transform: translateY(-100%); }
  /* Full-width bar: name on the far left, links on the far right */
  .hdr-in { display: flex; align-items: center; justify-content: space-between; height: 80px; padding-inline: clamp(16px, 2.5vw, 48px); }

  .brand { font-size: 1.25rem; letter-spacing: -0.02em; color: rgb(77 77 77); transition: color var(--dur-2) var(--ease-out); }
  .brand:hover { color: var(--ink); }

  .links { display: flex; gap: clamp(24px, 2.6vw, 40px); }
  .link { position: relative; display: inline-block; padding: 6px 0; font-size: 1rem; letter-spacing: -0.01em; color: rgb(115 115 115); transition: color var(--dur-2) var(--ease-out); }
  /* Hover: text darkens and lifts slightly; an underline draws in from the left */
  .link .label { display: inline-block; transition: transform var(--dur-2) var(--ease-spring); }
  .link::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 1.5px; border-radius: 2px; background: currentColor; transform: scaleX(0); transform-origin: right; transition: transform var(--dur-2) var(--ease-out); }
  .link:hover, .link:focus-visible { color: var(--ink); }
  .link:hover .label { transform: translateY(-2px); }
  .link:hover::after, .link:focus-visible::after { transform: scaleX(1); transform-origin: left; }
  .link.active { color: var(--ink); }

  .burger { display: none; position: relative; width: 44px; height: 44px; border: 0; background: transparent; border-radius: 12px; cursor: pointer; }
  .bar { position: absolute; left: 12px; right: 12px; height: 2px; border-radius: 2px; background: var(--ink); transition: transform var(--dur-2) var(--ease-out), top var(--dur-2) var(--ease-out); }
  .bar:nth-of-type(1) { top: 17px; } .bar:nth-of-type(2) { top: 25px; }
  .burger[aria-expanded='true'] .bar:nth-of-type(1) { top: 21px; transform: rotate(45deg); }
  .burger[aria-expanded='true'] .bar:nth-of-type(2) { top: 21px; transform: rotate(-45deg); }

  .menu { background: var(--surface); display: flex; flex-direction: column; gap: 4px; padding: 8px var(--gutter) 24px; }
  .menu[hidden] { display: none; }
  .menu a { font-size: 1.75rem; letter-spacing: -0.04em; padding: 10px 0; border-bottom: 1px solid var(--line); animation: menu-in var(--dur-2) var(--ease-out) both; animation-delay: calc(var(--i) * 60ms); }
  @keyframes menu-in { from { opacity: 0; transform: translateY(-8px); } }

  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  /* Phone breakpoint (Framer: < 810) */
  @media (max-width: 809px) {
    .links { display: none; }
    .burger { display: block; }
    .hdr-in { height: 64px; }
  }
</style>
