---
import type { Card } from '../data/site';
interface Props { card: Card; size?: 'lg' | 'md'; cursor?: string }
const { card, size = 'lg', cursor } = Astro.props;
const Tag = card.href ? 'a' : 'div';
const linkProps = card.href ? { href: card.href, ...(card.external ? { target: '_blank', rel: 'noopener' } : {}) } : {};
const [name, metric] = card.title.split(' I ');
---
<Tag class:list={['card', size]} {...linkProps} data-cursor={card.href ? cursor : undefined} data-reveal>
  <div class:list={['media', { contain: card.fit === 'contain' }]}>
    {card.media ? (
      <video data-autoplay muted loop playsinline preload="metadata" poster={card.poster} aria-hidden="true">
        <source src={card.media} type="video/mp4" />
      </video>
    ) : (
      <img src={card.poster} alt={card.alt ?? ''} loading="lazy" decoding="async" />
    )}
    {card.href && !cursor && (
      <span class="go" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="18" height="18"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M7 17 17 7M9 7h8v8"/></svg>
      </span>
    )}
  </div>
  <div class="body">
    <h3>{name}{metric && <span class="metric"> I {metric}</span>}</h3>
    <div class="tags">{card.tags.map((t) => <span class="tag">{t}</span>)}</div>
  </div>
</Tag>

<style>
  .card { display: flex; flex-direction: column; gap: 16px; border-radius: var(--radius-l); }
  .media {
    position: relative; overflow: hidden; border-radius: var(--radius-l);
    background: var(--img-bg); aspect-ratio: 2100 / 1240; isolation: isolate;
    box-shadow: var(--shadow-1);
    transition: box-shadow var(--dur-2) var(--ease-out), transform var(--dur-2) var(--ease-out);
  }
  .md .media { aspect-ratio: 4 / 3; }
  /* Portrait clips (e.g. a phone recording) sit whole on a soft backdrop instead of being cropped */
  .media.contain { background: var(--slate-1); }
  .media.contain video, .media.contain img { object-fit: contain; }
  .media video, .media img { width: 100%; height: 100%; object-fit: cover; transition: transform var(--dur-3) var(--ease-out); }
  .go {
    position: absolute; right: 14px; top: 14px; display: grid; place-items: center;
    width: 40px; height: 40px; border-radius: 50%; background: var(--surface); color: var(--ink);
    opacity: 0; transform: translate(-6px, 6px) scale(.8);
    transition: opacity var(--dur-2) var(--ease-out), transform var(--dur-2) var(--ease-spring);
  }
  .body { display: flex; flex-direction: column; gap: 10px; padding-inline: 4px; }
  h3 { font-size: var(--fs-small); letter-spacing: 0; line-height: 1.4; }
  .metric { color: var(--muted); }

  @media (hover: hover) {
    a.card:hover .media { box-shadow: var(--shadow-2); transform: translateY(-4px); }
    a.card:hover .media video, a.card:hover .media img { transform: scale(1.035); }
    a.card:hover .go { opacity: 1; transform: none; }
  }
  a.card:active .media { transform: scale(.985); }
</style>
