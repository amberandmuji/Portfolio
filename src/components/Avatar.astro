<script>
  const root = document.querySelector<HTMLElement>('[data-avatar]');
  if (root) {
    const art = root.querySelector('.art')!;
    const btn = root.querySelector<HTMLButtonElement>('[data-inspect]')!;
    let pinned = false;
    const set = (on: boolean) => root.classList.toggle('inspect', on);
    art.addEventListener('pointerenter', (e) => { if ((e as PointerEvent).pointerType === 'mouse') set(true); });
    art.addEventListener('pointerleave', (e) => { if ((e as PointerEvent).pointerType === 'mouse' && !pinned) set(false); });
    btn.addEventListener('click', () => {
      pinned = !pinned;
      btn.setAttribute('aria-pressed', String(pinned));
      set(pinned);
    });
  }
</script>

<style>
  .avatar { position: relative; width: 100%; max-width: 380px; }
  .art { display: block; width: 100%; height: auto; overflow: visible; font-family: inherit; -webkit-mask-image: linear-gradient(#000 86%, transparent); mask-image: linear-gradient(#000 86%, transparent); }

  /* Ink → blueprint morph */
  .ink * { transition: fill 420ms var(--ease-out), stroke 420ms var(--ease-out), stroke-width 420ms var(--ease-out); }
  .ink :is(path, circle):not([stroke]) { stroke: rgb(13 153 255 / 0); stroke-width: 1; }
  .grid { opacity: 0; transition: opacity 420ms var(--ease-out); }

  .inspect .ink :is(path, circle) { fill: transparent; stroke: #0d99ff; stroke-width: 1; }
  .inspect .grid { opacity: 1; }

  /* Annotation layer */
  .ann > g { opacity: 0; transform: translateY(4px); transition: opacity 260ms var(--ease-out), transform 260ms var(--ease-out); }
  .inspect .ann > g { opacity: 1; transform: none; }
  .inspect .ann > g:nth-child(2) { transition-delay: 60ms; }
  .inspect .ann > g:nth-child(3) { transition-delay: 100ms; }
  .inspect .ann > g:nth-child(4) { transition-delay: 140ms; }
  .inspect .ann > g:nth-child(5) { transition-delay: 170ms; }
  .inspect .ann > g:nth-child(6) { transition-delay: 200ms; }
  .inspect .ann > g:nth-child(7) { transition-delay: 230ms; }
  .inspect .ann > g:nth-child(8) { transition-delay: 260ms; }
  .inspect .ann > g:nth-child(9) { transition-delay: 290ms; }
  .ann text { font-variant-numeric: tabular-nums; letter-spacing: 0; }

  /* Toggle */
  .insp {
    display: flex; margin: 4px auto 0; align-items: center; gap: 8px;
    padding: 6px 12px 6px 6px; border-radius: 999px;
    background: rgb(255 255 255 / .85); backdrop-filter: blur(8px);
    border: 1px solid rgb(12 12 14 / .08); box-shadow: 0 4px 14px rgb(12 12 14 / .06);
    font-size: 13px; font-weight: 500; color: var(--ink); letter-spacing: -0.01em;
    transition: transform 200ms var(--ease-out), box-shadow 200ms;
  }
  .insp:hover { transform: translateY(-1px); box-shadow: 0 6px 18px rgb(12 12 14 / .1); }
  .insp:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .knob { position: relative; width: 28px; height: 16px; border-radius: 999px; background: #d9dee5; transition: background 220ms; }
  .knob::after { content: ''; position: absolute; left: 2px; top: 2px; width: 12px; height: 12px; border-radius: 50%; background: #fff; box-shadow: 0 1px 2px rgb(0 0 0 / .2); transition: transform 220ms var(--ease-spring); }
  .insp[aria-pressed='true'] .knob { background: #0d99ff; }
  .insp[aria-pressed='true'] .knob::after { transform: translateX(12px); }

  @media (prefers-reduced-motion: reduce) {
    .ink *, .grid, .ann > g { transition: none !important; }
  }
</style>
