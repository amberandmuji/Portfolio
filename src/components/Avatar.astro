---
// Black-ink line avatar with a Figma-style "inspect" view.
// Hovering (or the Inspect toggle) turns the drawing into a blueprint: every shape
// becomes a thin blue outline on a grid, and redlines, hex codes and radius callouts
// fade in. All measurements are real values from this SVG's own coordinates.
---
<div class="avatar" data-avatar>
  <svg class="art" viewBox="0 0 400 440" role="img" aria-label="Line-art avatar of Amber with long hair and see-through bangs">
    <defs>
      <pattern id="av-grid" width="20" height="20" patternUnits="userSpaceOnUse">
        <path d="M20 0H0V20" fill="none" stroke="#d3e3ff" stroke-width=".8" />
      </pattern>
    </defs>

    <rect class="grid" x="0" y="0" width="400" height="440" rx="24" fill="url(#av-grid)" />

    <g class="ink" stroke-linecap="round" stroke-linejoin="round">
      <!-- hair, back -->
      <path fill="#141414" d="M200 90c-62 0-90 40-92 100-2 58-6 108-14 150h212c-8-42-12-92-14-150-2-60-30-100-92-100Z" />

      <!-- neck -->
      <path fill="#fff" d="M184 262h32v52h-32Z" />
      <path fill="none" stroke="#141414" stroke-width="4.5" d="M184 266v40M216 266v40" />

      <!-- jacket -->
      <path fill="#141414" stroke="#fff" stroke-width="3" d="M52 440c4-60 38-96 96-112l36-22q16 10 32 0l36 22c58 16 92 52 96 112Z" />
      <!-- tee -->
      <path fill="#fff" stroke="#141414" stroke-width="4.5" d="M180 313q20 16 40 0l12 127h-64Z" />
      <path fill="none" stroke="#141414" stroke-width="4.5" d="M181 314q19 16 38 0" />
      <!-- collar + zip edges, drawn in white on the black jacket -->
      <path fill="#141414" stroke="#fff" stroke-width="3" d="M184 307l-38 22 20 40 16-42Zm32 0 38 22-20 40-16-42Z" />
      <path fill="none" stroke="#fff" stroke-width="2.5" d="M178 334l-10 106M222 334l10 106M112 350q14 34 10 90M288 350q-14 34-10 90" />

      <!-- face -->
      <path fill="#fff" stroke="#141414" stroke-width="4.5" d="M200 112c46 0 68 34 68 78 0 46-28 84-68 90-40-6-68-44-68-90 0-44 22-78 68-78Z" />

      <!-- hair falling in front of the shoulders -->
      <path fill="#141414" stroke="#fff" stroke-width="3" d="M146 150c-14 40-16 104-20 170-2 26-8 50-18 74l14-6 6 14 12-20c10-40 14-100 18-160 2-30 2-56-2-72Z" />
      <path fill="#141414" stroke="#fff" stroke-width="3" d="M254 150c14 40 18 104 22 170 2 28 8 52 20 76l8-14 10 10-4-30c-10-36-14-96-18-156-2-28-6-48-14-62Z" />

      <!-- ear + hoop -->
      <path fill="#fff" stroke="#141414" stroke-width="4" d="M262 196q14-6 14 10t-14 14" />
      <circle class="hoop" fill="none" stroke="#141414" stroke-width="2.6" cx="266" cy="226" r="5" />

      <!-- crown + see-through bangs -->
      <path fill="#141414" d="M132 182c-6-60 22-92 68-92s74 32 68 92c-6-18-14-32-26-40-24-8-60-8-84 0-12 8-20 22-26 40Z" />
      <path fill="none" stroke="#141414" stroke-width="3" d="M160 143q-4 16-9 30M173 140q-2 18-7 35M187 139q0 18-3 35M200 139q2 18 0 34M213 139q3 18 6 34M227 140q4 17 9 32M240 143q5 14 10 27" />
      <!-- gloss -->
      <path fill="none" stroke="#fff" stroke-width="4.5" d="M160 114q8-8 18-10" />
      <circle class="gloss" fill="#fff" cx="190" cy="102" r="3" />
      <path fill="none" stroke="#fff" stroke-width="3" d="M138 220q-2 30-4 60M264 230q2 26 4 50" />

      <!-- closed, smiling eyes -->
      <path fill="none" stroke="#141414" stroke-width="4.5" d="M157 207q11-10 22 0M221 207q11-10 22 0" />
      <!-- hatched blush -->
      <path fill="none" stroke="#b5b5b5" stroke-width="2" d="M159 230l4-7M165 230l4-7M171 230l4-7M177 230l4-7M219 230l4-7M225 230l4-7M231 230l4-7M237 230l4-7" />
      <!-- small smile -->
      <path fill="none" stroke="#141414" stroke-width="3.4" d="M193 247q7 6 14 0" />
    </g>

    <!-- ===== Inspect overlay ===== -->
    <g class="ann" font-size="10" font-weight="500" aria-hidden="true">
      <!-- selection box around the face -->
      <g>
        <rect x="132" y="112" width="136" height="168" fill="none" stroke="#0d99ff" stroke-width="1.2" />
        <rect x="129.5" y="109.5" width="5" height="5" fill="#fff" stroke="#0d99ff" />
        <rect x="265.5" y="109.5" width="5" height="5" fill="#fff" stroke="#0d99ff" />
        <rect x="129.5" y="277.5" width="5" height="5" fill="#fff" stroke="#0d99ff" />
        <rect x="265.5" y="277.5" width="5" height="5" fill="#fff" stroke="#0d99ff" />
        <rect x="171" y="68" width="58" height="15" rx="3" fill="#0d99ff" />
        <text x="200" y="79" text-anchor="middle" fill="#fff">136 × 168</text>
      </g>
      <!-- redline: gap between the eyes -->
      <g>
        <path d="M179 211v6M221 211v6M179 214h42" stroke="#f24822" stroke-width="1" fill="none" />
        <rect x="190" y="219" width="20" height="13" rx="3" fill="#f24822" />
        <text x="200" y="229" text-anchor="middle" fill="#fff">42</text>
      </g>
      <!-- redline: chin to neckline -->
      <g>
        <path d="M231 280h10M231 322h10M236 280v42" stroke="#f24822" stroke-width="1" fill="none" />
        <rect x="243" y="294.5" width="20" height="13" rx="3" fill="#f24822" />
        <text x="253" y="304.5" text-anchor="middle" fill="#fff">42</text>
      </g>
      <!-- hex codes + stroke -->
      <g>
        <path d="M86 157h28" stroke="#8a94a6" stroke-width=".8" stroke-dasharray="2 2" />
        <circle cx="115" cy="157" r="2" fill="#8a94a6" />
        <rect x="6" y="148" width="80" height="18" rx="4" fill="#fff" stroke="#dde3ea" />
        <rect x="12" y="153" width="8" height="8" rx="2" fill="#141414" />
        <text x="25" y="161" fill="#3a4250">Ink #141414</text>
      </g>
      <g>
        <path d="M250 182h52" stroke="#8a94a6" stroke-width=".8" stroke-dasharray="2 2" />
        <circle cx="250" cy="182" r="2" fill="#8a94a6" />
        <rect x="302" y="173" width="92" height="18" rx="4" fill="#fff" stroke="#dde3ea" />
        <rect x="308" y="178" width="8" height="8" rx="2" fill="#fff" stroke="#c7ced8" stroke-width=".8" />
        <text x="321" y="186" fill="#3a4250">Paper #FFFFFF</text>
      </g>
      <g>
        <path d="M241 228h61" stroke="#8a94a6" stroke-width=".8" stroke-dasharray="2 2" />
        <circle cx="241" cy="228" r="2" fill="#8a94a6" />
        <rect x="302" y="219" width="92" height="18" rx="4" fill="#fff" stroke="#dde3ea" />
        <rect x="308" y="224" width="8" height="8" rx="2" fill="#b5b5b5" />
        <text x="321" y="232" fill="#3a4250">Blush #B5B5B5</text>
      </g>
      <g>
        <path d="M86 280h48" stroke="#8a94a6" stroke-width=".8" stroke-dasharray="2 2" />
        <circle cx="134" cy="280" r="2" fill="#8a94a6" />
        <rect x="6" y="271" width="80" height="18" rx="4" fill="#fff" stroke="#dde3ea" />
        <path d="M12 280h8" stroke="#141414" stroke-width="3" stroke-linecap="round" />
        <text x="25" y="284" fill="#3a4250">Stroke 4.5</text>
      </g>
      <!-- radius callouts -->
      <g>
        <path d="M271 226a5 5 0 0 0-5-5" stroke="#9747ff" stroke-width="1.6" fill="none" stroke-linecap="round" />
        <path d="M273 230l29 24" stroke="#9747ff" stroke-width=".8" />
        <rect x="302" y="249" width="56" height="15" rx="3" fill="#9747ff" />
        <text x="330" y="260" text-anchor="middle" fill="#fff">Radius 5</text>
      </g>
      <g>
        <path d="M193 102a3 3 0 0 0-3-3" stroke="#9747ff" stroke-width="1.6" fill="none" stroke-linecap="round" />
        <path d="M195 98l58-28" stroke="#9747ff" stroke-width=".8" />
        <rect x="253" y="58" width="56" height="15" rx="3" fill="#9747ff" />
        <text x="281" y="69" text-anchor="middle" fill="#fff">Radius 3</text>
      </g>
    </g>
  </svg>

  <button class="insp" type="button" aria-pressed="false" data-inspect>
    <span class="knob" aria-hidden="true"></span>
    <span class="lbl">Inspect</span>
  </button>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-avatar]');
  if (root) {
    const art = root.querySelector('.art')!;
    const btn = root.querySelector<HTMLButtonElement>('[data-inspect]')!;
    let pinned = false;
    const set = (on: boolean) => root.classList.toggle('inspect', on);
    art.addEventListener('pointerenter', (e) => { if ((e as PointerEvent).pointerType === 'mouse') set(true); });
    art.addEventListener('pointerleave', (e) => { if ((e as PointerEvent).pointerType === 'mouse' && !pinned) set(false); });
    btn.addEventListener('click', () => {
      pinned = !pinned;
      btn.setAttribute('aria-pressed', String(pinned));
      set(pinned);
    });
  }
</script>

<style>
  .avatar { position: relative; width: 100%; max-width: 380px; }
  .art { display: block; width: 100%; height: auto; overflow: visible; font-family: inherit; }

  /* Ink → blueprint morph */
  .ink * { transition: fill 420ms var(--ease-out), stroke 420ms var(--ease-out), stroke-width 420ms var(--ease-out); }
  .ink :is(path, circle):not([stroke]) { stroke: rgb(13 153 255 / 0); stroke-width: 1; }
  .grid { opacity: 0; transition: opacity 420ms var(--ease-out); }

  .inspect .ink :is(path, circle) { fill: transparent; stroke: #0d99ff; stroke-width: 1; }
  .inspect .grid { opacity: 1; }

  /* Annotation layer */
  .ann > g { opacity: 0; transform: translateY(4px); transition: opacity 260ms var(--ease-out), transform 260ms var(--ease-out); }
  .inspect .ann > g { opacity: 1; transform: none; }
  .inspect .ann > g:nth-child(2) { transition-delay: 60ms; }
  .inspect .ann > g:nth-child(3) { transition-delay: 100ms; }
  .inspect .ann > g:nth-child(4) { transition-delay: 140ms; }
  .inspect .ann > g:nth-child(5) { transition-delay: 170ms; }
  .inspect .ann > g:nth-child(6) { transition-delay: 200ms; }
  .inspect .ann > g:nth-child(7) { transition-delay: 230ms; }
  .inspect .ann > g:nth-child(8) { transition-delay: 260ms; }
  .inspect .ann > g:nth-child(9) { transition-delay: 290ms; }
  .ann text { font-variant-numeric: tabular-nums; letter-spacing: 0; }

  /* Toggle */
  .insp {
    display: flex; margin: 4px auto 0; align-items: center; gap: 8px;
    padding: 6px 12px 6px 6px; border-radius: 999px;
    background: rgb(255 255 255 / .85); backdrop-filter: blur(8px);
    border: 1px solid rgb(12 12 14 / .08); box-shadow: 0 4px 14px rgb(12 12 14 / .06);
    font-size: 13px; font-weight: 500; color: var(--ink); letter-spacing: -0.01em;
    transition: transform 200ms var(--ease-out), box-shadow 200ms;
  }
  .insp:hover { transform: translateY(-1px); box-shadow: 0 6px 18px rgb(12 12 14 / .1); }
  .insp:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .knob { position: relative; width: 28px; height: 16px; border-radius: 999px; background: #d9dee5; transition: background 220ms; }
  .knob::after { content: ''; position: absolute; left: 2px; top: 2px; width: 12px; height: 12px; border-radius: 50%; background: #fff; box-shadow: 0 1px 2px rgb(0 0 0 / .2); transition: transform 220ms var(--ease-spring); }
  .insp[aria-pressed='true'] .knob { background: #0d99ff; }
  .insp[aria-pressed='true'] .knob::after { transform: translateX(12px); }

  @media (prefers-reduced-motion: reduce) {
    .ink *, .grid, .ann > g { transition: none !important; }
  }
</style>
