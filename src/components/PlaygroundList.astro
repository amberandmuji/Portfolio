---
// Playground page: projects stacked one per row — video on one side, title,
// one-line description and tags (project type + tools used) on the other.
import type { Card } from '../data/site';
interface Props { cards: Card[] }
const { cards } = Astro.props;
---
<ol class="pl">
  {cards.map((card, i) => {
    const Tag = card.href ? 'a' : 'div';
    const linkProps = card.href ? { href: card.href, ...(card.external ? { target: '_blank', rel: 'noopener' } : {}) } : {};
    return (
      <li class:list={['row', { flip: i % 2 === 1 }]} data-reveal>
        <Tag class="media" {...linkProps} data-cursor={card.href ? 'Try it out!' : undefined} tabindex={card.href ? undefined : -1}
          style={[card.ratio && `aspect-ratio:${card.ratio}`, card.bg && `background:${card.bg}`].filter(Boolean).join(';') || undefined}>
          <video data-autoplay muted loop playsinline preload="metadata" poster={card.poster} aria-hidden="true" class:list={[card.fit === 'contain' && 'contain']}>
            <source src={card.media} type="video/mp4" />
          </video>
        </Tag>
        <div class="info">
          <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h2 class="title">{card.href ? <a href={card.href} {...(card.external ? { target: '_blank', rel: 'noopener' } : {})}>{card.title}</a> : card.title}</h2>
          {card.desc && <p class="desc">{card.desc}</p>}
          <div class="tags">{[...(card.kinds ?? []), ...card.tags].map((k) => <span class="tag">{k}</span>)}</div>
          {card.href
            ? <a class="go" href={card.href} {...(card.external ? { target: '_blank', rel: 'noopener' } : {})}>Try it out <span aria-hidden="true">↗</span></a>
            : <span class="soon">In progress</span>}
        </div>
      </li>
    );
  })}
</ol>

<style>
  .pl { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: clamp(64px, 9vw, 128px); }
  .row { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(28px, 4vw, 64px); align-items: center; }
  .row.flip { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
  .row.flip .media { order: 2; }

  .media {
    position: relative; display: block; overflow: hidden; border-radius: 12px; aspect-ratio: 16 / 9;
    background: var(--img-bg); isolation: isolate;
    transition: box-shadow var(--dur-2) var(--ease-out), transform var(--dur-2) var(--ease-out);
  }
  .media video { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform var(--dur-3) var(--ease-out); }
  .media video.contain { object-fit: contain; }
  @media (hover: hover) {
    a.media:hover { transform: translateY(-4px); box-shadow: var(--shadow-2); }
    a.media:hover video:not(.contain) { transform: scale(1.03); }
  }

  .info { display: flex; flex-direction: column; align-items: flex-start; }
  .num { font-size: var(--fs-body); color: var(--muted); font-variant-numeric: tabular-nums; }
  .title { margin-top: 6px; font-size: var(--fs-section); letter-spacing: -0.04em; line-height: 1.3; }
  .title a { color: inherit; }
  .desc { margin-top: 12px; font-size: var(--fs-bio); letter-spacing: -0.02em; line-height: 1.5; color: var(--muted); text-wrap: pretty; }
  .tags { margin-top: 20px; }
  .go { margin-top: 20px; display: inline-flex; align-items: center; gap: 6px; padding: 10px 18px; border-radius: 999px; background: var(--ink); color: #fff; font-weight: 500; transition: transform var(--dur-2) var(--ease-out), opacity var(--dur-2); }
  .go:hover { transform: translateY(-2px); opacity: .9; }
  .go span { transition: transform var(--dur-2) var(--ease-out); }
  .go:hover span { transform: translate(2px, -2px); }
  .soon { margin-top: 20px; padding: 10px 18px; border-radius: 999px; border: 1px dashed rgb(12 12 14 / .2); color: var(--muted); }

  @media (max-width: 809px) {
    .row { grid-template-columns: minmax(0, 1fr); gap: 20px; }
    .row.flip { grid-template-columns: minmax(0, 1fr); }
    .row.flip .media { order: 0; }
  }
</style>
