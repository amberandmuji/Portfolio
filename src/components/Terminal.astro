---
// A compact terminal that types `npx render-amber`, then prints Amber's portrait
// in asterisks next to a neofetch-style info panel.
// The grid comes from tools/ascii-portrait.py (background removed, local contrast,
// Floyd–Steinberg dithered to 3 levels: 0 empty, 1 dim, 2 bright).
import grid from '../data/amber-ascii.json';
const info: [string, string][] = [
  ['role', 'Product Designer'],
  ['roots', 'Engineering'],
  ['ships', 'B2B · B2C'],
  ['domains', 'Fintech · Healthcare'],
  ['toolkit', 'Data + AI tools'],
];
---
<div class="term" data-term>
  <div class="bar">
    <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="title">amber — zsh</span>
    <button class="replay" type="button" aria-label="Replay the animation" data-replay>
      <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M13.5 8a5.5 5.5 0 1 1-1.8-4.07M13.5 2.5v3.2h-3.2" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>
  </div>
  <div class="body">
    <p class="ln"><span class="ps">~</span> <span class="ps2">$</span> <span data-typed></span><span class="caret" data-caret></span></p>
    <div class="out">
      <canvas class="art" data-art role="img" aria-label="Amber's portrait drawn with asterisks" style={`aspect-ratio:${grid.cols}/${grid.rows.length}`}></canvas>
      <div class="info">
        <p class="ln head" data-info><span class="hl">amber</span>@<span class="hl">portfolio</span></p>
        <p class="ln rule" data-info>-----------------</p>
        {info.map(([k, v]) => <p class="ln" data-info><span class="k">{k}</span>{v}</p>)}
        <p class="ln swatches" data-info aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></p>
      </div>
    </div>
    <p class="ln end" data-end><span class="ps">~</span> <span class="ps2">$</span> <span class="caret blink"></span></p>
  </div>
</div>

<script define:vars={{ grid }}>
  const root = document.querySelector('[data-term]');
  const typed = root.querySelector('[data-typed]');
  const caret = root.querySelector('[data-caret]');
  const infoEl = [...root.querySelectorAll('[data-info]')];
  const endEl = root.querySelector('[data-end]');
  const canvas = root.querySelector('[data-art]');
  const ctx = canvas.getContext('2d');
  const COMMAND = 'npx render-amber';
  const MONO = 'ui-monospace, "SF Mono", SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace';
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const rows = grid.rows, COLS = grid.cols, ROWS = rows.length;

  let shown = 0, run = 0, pointer = null, cell = 3, dpr = 1;

  function size() {
    dpr = Math.min(2, window.devicePixelRatio || 1);
    const w = canvas.clientWidth;
    cell = w / COLS;
    canvas.width = Math.round(w * dpr);
    canvas.height = Math.round(cell * ROWS * dpr);
    draw();
  }
  function draw() {
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    const big = `700 ${(cell * 1.85).toFixed(2)}px ${MONO}`;
    const small = `700 ${(cell * 1.45).toFixed(2)}px ${MONO}`;
    const R = cell * 12;
    for (let y = 0; y < shown; y++) {
      const r = rows[y];
      const cy = y * cell + cell * 0.8;            // '*' sits high in the em box, nudge it down
      for (let x = 0; x < COLS; x++) {
        const k = r.charCodeAt(x) - 48;
        if (!k) continue;
        const cx = x * cell + cell / 2;
        let glow = 0;
        if (pointer) { const d = Math.hypot(cx - pointer.x, cy - pointer.y); if (d < R) glow = Math.min(1, (1 - d / R) * 1.4); }
        ctx.font = k === 2 ? big : small;
        if (glow > 0) ctx.fillStyle = `rgba(${Math.round(232 - 175 * glow)}, ${Math.round(236 - 90 * glow)}, ${Math.round(241 + 6 * glow)}, ${k === 2 ? 1 : 0.5 + 0.5 * glow})`;
        else ctx.fillStyle = k === 2 ? 'rgb(232 236 241)' : 'rgb(232 236 241 / .55)';
        ctx.fillText('*', cx, cy);
      }
    }
  }

  const wait = (ms, id) => new Promise((res, rej) => setTimeout(() => (id === run ? res() : rej()), ms));
  function reset() {
    typed.textContent = ''; caret.hidden = false;
    infoEl.forEach((el) => el.classList.remove('on'));
    endEl.classList.remove('on');
    shown = 0; draw();
  }
  function finish() {
    typed.textContent = COMMAND; caret.hidden = true;
    infoEl.forEach((el) => el.classList.add('on'));
    shown = ROWS; draw(); endEl.classList.add('on');
  }
  async function play() {
    const id = ++run;
    reset();
    if (reduce) return finish();
    try {
      await wait(450, id);
      for (const ch of COMMAND) { typed.textContent += ch; await wait(45 + Math.random() * 60, id); }
      await wait(300, id);
      caret.hidden = true;
      // portrait prints a row at a time while the info lines come in alongside it
      await new Promise((res, rej) => {
        let last = 0;
        const tick = (t) => {
          if (id !== run) return rej();
          if (t - last > 16) {
            shown = Math.min(ROWS, shown + 1); last = t; draw();
            const n = Math.floor(shown / ROWS * (infoEl.length + 1));
            infoEl.slice(0, n).forEach((el) => el.classList.add('on'));
          }
          shown < ROWS ? requestAnimationFrame(tick) : res();
        };
        requestAnimationFrame(tick);
      });
      infoEl.forEach((el) => el.classList.add('on'));
      await wait(250, id);
      endEl.classList.add('on');
    } catch { /* replaced by a newer run */ }
  }

  // hover: stars near the pointer light up in blue
  canvas.addEventListener('pointermove', (e) => {
    const r = canvas.getBoundingClientRect();
    pointer = { x: e.clientX - r.left, y: e.clientY - r.top };
    if (!draw._q) { draw._q = true; requestAnimationFrame(() => { draw._q = false; draw(); }); }
  });
  canvas.addEventListener('pointerleave', () => { pointer = null; draw(); });
  root.querySelector('[data-replay]').addEventListener('click', play);

  new ResizeObserver(size).observe(canvas);
  const io = new IntersectionObserver((ents) => { if (ents.some((e) => e.isIntersecting)) { io.disconnect(); play(); } }, { threshold: 0.3 });
  io.observe(root);
</script>

<style>
  .term {
    --mono: ui-monospace, "SF Mono", SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace;
    width: 100%; max-width: 460px; border-radius: 12px; overflow: hidden;
    background: #0e1014; color: #e8ecf1;
    border: 1px solid rgb(255 255 255 / .06);
    box-shadow: 0 1px 2px rgb(12 12 14 / .08), 0 24px 60px -12px rgb(12 12 14 / .28);
    font-family: var(--mono); font-size: 12.5px; line-height: 19px; letter-spacing: 0;
    font-variation-settings: normal;
  }
  .bar { position: relative; display: flex; align-items: center; height: 34px; padding: 0 12px; background: #16191f; border-bottom: 1px solid rgb(255 255 255 / .05); }
  .lights { display: flex; gap: 7px; }
  .lights i { width: 11px; height: 11px; border-radius: 50%; background: #ff5f57; }
  .lights i:nth-child(2) { background: #febc2e; }
  .lights i:nth-child(3) { background: #28c840; }
  .title { position: absolute; left: 50%; transform: translateX(-50%); font-size: 11.5px; color: #8b93a1; }
  .replay { margin-left: auto; padding: 0; border: 0; background: transparent; cursor: pointer; display: grid; place-items: center; width: 24px; height: 24px; border-radius: 6px; color: #8b93a1; transition: color 150ms, background 150ms, transform 300ms var(--ease-out); }
  .replay:hover { color: #e8ecf1; background: rgb(255 255 255 / .06); }
  .replay:active { transform: rotate(-90deg); }
  .replay:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }

  .body { padding: 12px 16px 12px; }
  .ln { margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ps { color: #7aa2f7; font-weight: 700; }
  .ps2 { color: #6ee7a8; font-weight: 700; }

  .out { display: grid; grid-template-columns: 44% minmax(0, 1fr); gap: 18px; align-items: center; margin: 10px 0 8px; }
  .art { display: block; width: 100%; cursor: crosshair; }
  .info [data-info] { opacity: 0; transform: translateX(-4px); transition: opacity 200ms, transform 200ms; }
  .info [data-info].on { opacity: 1; transform: none; }
  .hl { color: #7aa2f7; font-weight: 700; }
  .head { color: #8b93a1; }
  .rule { color: #4b5260; }
  .k { display: inline-block; width: 8ch; color: #6ee7a8; font-weight: 700; }
  .swatches { display: flex; gap: 0; margin-top: 8px; }
  .swatches i { width: 18px; height: 12px; }
  .swatches i:nth-child(1) { background: #3992f7; }
  .swatches i:nth-child(2) { background: #6ee7a8; }
  .swatches i:nth-child(3) { background: #febc2e; }
  .swatches i:nth-child(4) { background: #ff5f57; }
  .swatches i:nth-child(5) { background: #c084fc; }
  .swatches i:nth-child(6) { background: #e8ecf1; }

  .end { opacity: 0; }
  .end.on { opacity: 1; }
  .caret { display: inline-block; width: 7px; height: 14px; margin-left: 2px; vertical-align: -2px; background: #e8ecf1; }
  .caret[hidden] { display: none; }
  .caret.blink { animation: blink 1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }

  @media (max-width: 420px) {
    .term { font-size: 10.5px; line-height: 16px; }
    .out { grid-template-columns: 40% minmax(0, 1fr); gap: 10px; }
  }
</style>
