  .copy { max-width: 470px; min-width: 0; }
  h2 { font-size: var(--fs-section); letter-spacing: -0.04em; line-height: 1.4; }
  .sub { margin-top: 2px; color: var(--muted); }

  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 18px; }
