---
// "Make yourself a drink!" — rebuilt from the Framer footer embed.
const ingredients = [
  { id: 'ice', label: 'Ice', color: '#dff1f7' },
  { id: 'milk', label: 'Milk', color: '#fbf7ee' },
  { id: 'oat', label: 'Oat milk', color: '#efe2c6' },
  { id: 'matcha', label: 'Matcha', color: '#7aa14a' },
  { id: 'hojicha', label: 'Hojicha', color: '#9a6a43' },
  { id: 'honey', label: 'Honey', color: '#f2b84b' },
  { id: 'strawberry', label: 'Strawberry', color: '#ea7a8c' },
  { id: 'mango', label: 'Mango', color: '#f6b33f' },
  { id: 'boba', label: 'Boba', color: '#3b2a22' },
  { id: 'foam', label: 'Cold foam', color: '#fffdf8' },
];
---
<section class="game" aria-labelledby="game-title" data-reveal>
  <div class="panel">
    <div class="stage">
      <div class="cup-wrap" data-cup-wrap>
        <div class="cup" aria-hidden="true">
          <div class="liquid" data-liquid></div>
          <div class="boba" data-boba></div>
          <div class="ice" data-ice></div>
          <div class="foam" data-foam></div>
          <div class="shine"></div>
        </div>
        <div class="saucer" aria-hidden="true"></div>
        <div class="served" data-served hidden>
          <span class="eyebrow">Order up</span>
          <strong data-drink-name></strong>
          <button class="btn" type="button" data-again>Make another</button>
        </div>
      </div>
    </div>

    <div class="copy">
      <h2 id="game-title">Make yourself a drink!</h2>
      <p class="sub">Tap ingredients to pour them in, then serve it.</p>

      <div class="chips" role="group" aria-label="Ingredients">
        {ingredients.map((g) => (
          <button class="chip" type="button" data-add={g.id} style={`--c:${g.color}`}>
            <span class="swatch" aria-hidden="true"></span>{g.label}
          </button>
        ))}
      </div>

      <div class="actions">
        <button class="btn primary" type="button" data-serve disabled>Serve it</button>
        <button class="btn" type="button" data-undo disabled>Undo</button>
        <button class="btn" type="button" data-reset disabled>Start over</button>
      </div>
      <p class="status" aria-live="polite" data-status>Your cup is empty.</p>
    </div>
  </div>
</section>

<script define:vars={{ ingredients }}>
  const root = document.getElementById('game-title').closest('.game');
  const $ = (s) => root.querySelector(s);
  const colors = Object.fromEntries(ingredients.map((g) => [g.id, g.color]));
  const labels = Object.fromEntries(ingredients.map((g) => [g.id, g.label]));
  const LIQUIDS = ['milk', 'oat', 'matcha', 'hojicha', 'honey', 'strawberry', 'mango'];
  const MAX = 9;
  let cup = [];

  const liquidEl = $('[data-liquid]'), bobaEl = $('[data-boba]'), iceEl = $('[data-ice]'), foamEl = $('[data-foam]');
  const status = $('[data-status]');

  function render(lastAdded) {
    const liquids = cup.filter((c) => LIQUIDS.includes(c));
    liquidEl.innerHTML = '';
    liquids.forEach((id, i) => {
      const layer = document.createElement('div');
      layer.className = 'layer' + (i === liquids.length - 1 && lastAdded === id ? ' pour' : '');
      layer.style.background = colors[id];
      liquidEl.appendChild(layer);
    });

    const boba = cup.filter((c) => c === 'boba').length;
    bobaEl.innerHTML = Array.from({ length: Math.min(boba * 7, 21) }, (_, i) =>
      `<i style="--x:${(i * 37) % 88}%;--y:${Math.floor(i / 7) * 14}px;--d:${i * 25}ms"></i>`).join('');

    const ice = cup.filter((c) => c === 'ice').length;
    iceEl.innerHTML = Array.from({ length: Math.min(ice * 3, 9) }, (_, i) =>
      `<i style="--x:${10 + ((i * 29) % 62)}%;--y:${20 + ((i * 17) % 50)}%;--r:${(i * 23) % 40 - 20}deg;--d:${i * 40}ms"></i>`).join('');

    foamEl.classList.toggle('on', cup.includes('foam'));

    const n = cup.length;
    $('[data-serve]').disabled = n === 0;
    $('[data-undo]').disabled = n === 0;
    $('[data-reset]').disabled = n === 0;
    root.querySelectorAll('[data-add]').forEach((b) => (b.disabled = n >= MAX));
    status.textContent = n === 0 ? 'Your cup is empty.'
      : n >= MAX ? 'Your cup is full — serve it!'
      : `In your cup: ${[...new Set(cup)].map((c) => labels[c].toLowerCase()).join(', ')}.`;
  }

  function nameDrink() {
    const has = (x) => cup.includes(x);
    const liquids = cup.filter((c) => LIQUIDS.includes(c));
    if (!liquids.length) {
      if (has('boba')) return 'Just boba? Bold choice.';
      if (has('ice')) return 'A cup of ice. Very hydrating.';
      return 'A cloud of cold foam';
    }
    const fruit = ['strawberry', 'mango'].filter(has).map((f) => f[0].toUpperCase() + f.slice(1));
    const tea = has('matcha') && has('hojicha') ? 'Matcha-Hojicha' : has('matcha') ? 'Matcha' : has('hojicha') ? 'Hojicha' : '';
    const milk = has('oat') ? 'Oat ' : '';
    const isLatte = has('milk') || has('oat');
    let base = tea
      ? `${milk}${tea}${isLatte ? ' Latte' : ''}`
      : isLatte ? `${fruit.length ? '' : 'Plain '}${milk || ''}Milk` : 'Mystery Brew';
    if (!tea && !isLatte && fruit.length) base = `${fruit.join('-')} Juice`;
    else if (fruit.length) base = `${fruit.join('-')} ${base}`;
    if (has('honey')) base = `Honey ${base}`;
    if (has('ice')) base = `Iced ${base}`;
    const extras = [has('boba') && 'Boba', has('foam') && 'Cold Foam'].filter(Boolean);
    return extras.length ? `${base} with ${extras.join(' & ')}` : base;
  }

  root.addEventListener('click', (e) => {
    const b = e.target.closest('button');
    if (!b) return;
    if (b.dataset.add) {
      if (cup.length >= MAX) return;
      cup.push(b.dataset.add);
      b.classList.remove('pop'); void b.offsetWidth; b.classList.add('pop');
      render(b.dataset.add);
    } else if ('undo' in b.dataset) { cup.pop(); render(); }
    else if ('reset' in b.dataset) { cup = []; render(); }
    else if ('serve' in b.dataset) {
      $('[data-drink-name]').textContent = nameDrink();
      $('[data-cup-wrap]').classList.add('is-served');
      $('[data-served]').hidden = false;
      status.textContent = 'Served! Enjoy.';
    } else if ('again' in b.dataset) {
      cup = [];
      $('[data-cup-wrap]').classList.remove('is-served');
      $('[data-served]').hidden = true;
      render();
    }
  });
</script>

<style>
  /* Full-width grey band directly above the footer, as on the Framer site */
  .game { margin-top: 100px; background: var(--footer-bg); padding: 60px var(--edge); }
  .panel { display: flex; align-items: center; justify-content: center; gap: clamp(32px, 4vw, 56px); max-width: 860px; margin-inline: auto; }
  .copy { max-width: 460px; }
  h2 { font-size: 1.25rem; line-height: 1.4; color: rgb(43 40 35); }
  .sub { margin-top: 2px; font-size: 0.8125rem; color: var(--muted); }

  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
  .chip {
    display: inline-flex; align-items: center; gap: 8px; height: 34px; padding: 0 14px 0 10px; border-radius: 999px;
    border: 1px solid rgb(12 12 14 / .12); background: rgb(12 12 14 / .03);
    cursor: pointer; font-size: 0.875rem; letter-spacing: 0; color: rgb(43 40 35);
    transition: transform var(--dur-1) var(--ease-out), background var(--dur-1), border-color var(--dur-1);
  }
  .chip:hover:not(:disabled) { background: var(--surface); border-color: rgb(12 12 14 / .2); transform: translateY(-1px); }
  .chip:active:not(:disabled) { transform: scale(.95); }
  .chip:disabled { opacity: .45; cursor: not-allowed; }
  .chip.pop { animation: pop 380ms var(--ease-spring); }
  @keyframes pop { 40% { transform: scale(1.1); } }
  .swatch { width: 14px; height: 14px; border-radius: 50%; background: var(--c); box-shadow: inset 0 0 0 1px rgb(0 0 0 / .14); }

  .actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
  .btn {
    height: 36px; padding: 0 16px; border-radius: 999px; border: 1px solid rgb(12 12 14 / .1); background: transparent;
    font-size: 0.875rem; color: rgb(43 40 35); cursor: pointer;
    transition: transform var(--dur-1) var(--ease-out), background var(--dur-1), opacity var(--dur-1);
  }
  .btn:hover:not(:disabled) { background: var(--surface); }
  .btn:active:not(:disabled) { transform: scale(.96); }
  .btn:disabled { color: rgb(12 12 14 / .3); cursor: not-allowed; }
  .btn.primary { background: var(--accent); border-color: transparent; color: #fff; font-weight: 600; }
  .btn.primary:hover:not(:disabled) { background: rgb(37 128 232); }
  .btn.primary:disabled { background: rgb(57 146 247 / .4); color: #fff; }
  .status { margin-top: 14px; font-size: 0.8125rem; color: var(--muted); min-height: 1.5em; }

  /* Glass */
  .stage { flex: none; display: grid; place-items: center; width: 180px; }
  .cup-wrap { position: relative; width: 140px; height: 214px; transition: transform 700ms var(--ease-out); }
  .cup {
    position: absolute; inset: 0 0 14px 0; overflow: hidden;
    clip-path: polygon(0 0, 100% 0, 88% 100%, 12% 100%);
    background: linear-gradient(90deg, rgb(255 255 255 / .9), rgb(255 255 255 / .6));
    border-radius: 2px 2px 12px 12px;
  }
  .cup::before { content: ''; position: absolute; inset: 0; clip-path: inherit; box-shadow: inset 0 0 0 2.5px rgb(160 160 160); border-radius: inherit; pointer-events: none; z-index: 5; }
  .shine { position: absolute; left: 13%; top: 4%; width: 7%; height: 82%; border-radius: 99px; background: linear-gradient(rgb(255 255 255 / .9), rgb(255 255 255 / 0)); z-index: 6; }
  .saucer { position: absolute; left: 10px; right: 10px; bottom: 0; height: 8px; border-radius: 50%; background: rgb(12 12 14 / .08); }
  .liquid { position: absolute; inset: auto 0 0 0; display: flex; flex-direction: column-reverse; }
  .liquid :global(.layer) { height: 19px; transition: height 500ms var(--ease-out); }
  .liquid :global(.layer.pour) { animation: pour 600ms var(--ease-out); }
  @keyframes pour { from { height: 0; filter: brightness(1.1); } }
  .boba { position: absolute; inset: auto 14% 3px 14%; height: 40px; z-index: 2; }
  .boba :global(i) { position: absolute; left: var(--x); bottom: var(--y); width: 12px; height: 12px; border-radius: 50%; background: radial-gradient(circle at 35% 30%, #6b5245, #2a1c16); animation: drop 520ms var(--ease-spring) both; animation-delay: var(--d); }
  @keyframes drop { from { transform: translateY(-180px); opacity: 0; } }
  .ice { position: absolute; inset: 0; z-index: 3; }
  .ice :global(i) { position: absolute; left: var(--x); top: var(--y); width: 26px; height: 23px; border-radius: 6px; background: rgb(255 255 255 / .55); box-shadow: inset 0 0 0 1.5px rgb(255 255 255 / .95); transform: rotate(var(--r)); animation: plunk 600ms var(--ease-spring) both; animation-delay: var(--d); }
  @keyframes plunk { from { transform: translateY(-200px) rotate(0); opacity: 0; } }
  .foam { position: absolute; left: 0; right: 0; top: 0; height: 0; background: #fffdf8; z-index: 4; transition: height 600ms var(--ease-out); }
  .foam.on { height: 26px; }

  .cup-wrap.is-served { transform: translateY(-10px) rotate(-3deg); }
  .served {
    position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); z-index: 8;
    width: max-content; max-width: 240px; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 8px;
    background: var(--surface); border-radius: var(--radius-m); padding: 14px 18px; box-shadow: var(--shadow-2);
    animation: served-in 520ms var(--ease-spring) both;
  }
  .served[hidden] { display: none; }
  .served strong { font-weight: 400; font-size: 1rem; line-height: 1.4; }
  @keyframes served-in { from { opacity: 0; transform: translate(-50%, -40%) scale(.9); } }

  @media (max-width: 809px) {
    .panel { flex-direction: column; align-items: stretch; }
    .stage { width: 100%; padding-bottom: 8px; }
  }
</style>
