  .status { margin-top: 14px; font-size: 0.875rem; color: var(--muted); min-height: 1.5em; }

  .result { margin-top: 18px; display: flex; flex-direction: column; gap: 10px; animation: rise-in 520ms var(--ease-out) both; }
  .result[hidden], .build[hidden] { display: none; }
