  @keyframes plunk { from { transform: translateY(-220px); opacity: 0; } 35% { opacity: 1; } }
  @keyframes bob { 0%, 100% { transform: rotate(var(--r)) translateY(0); } 50% { transform: rotate(calc(var(--r) + 3deg)) translateY(-2px); } }

