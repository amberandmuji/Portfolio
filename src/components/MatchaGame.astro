  .cubes :global(i span) {
    position: absolute; inset: 0; border-radius: 6px; transform: rotate(var(--r));
    background: linear-gradient(135deg, rgb(240 249 253 / .95), rgb(196 224 238 / .78));
    border: 1px solid rgb(118 156 180 / .7);
