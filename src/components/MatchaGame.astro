  @keyframes rise-in { from { opacity: 0; transform: translateY(8px); } }

  /* ---------- Glass ---------- */
  .stage { flex: none; position: relative; width: 190px; display: grid; justify-items: center; padding-top: 40px; }
  .glass { position: relative; width: 150px; height: 230px; }
  .inside {
    position: absolute; inset: 0; overflow: hidden;
    clip-path: polygon(2% 3.2%, 98% 3.2%, 88.7% 98%, 11.3% 98%);
    background: linear-gradient(180deg, rgb(255 255 255 / .55), rgb(236 242 246 / .65));
  }
  .outline { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 6; }
  .coaster { width: 150px; height: 12px; margin-top: -6px; border-radius: 50%; background: radial-gradient(ellipse at center, rgb(12 12 14 / .14), rgb(12 12 14 / 0) 70%); }

  .liquid { position: absolute; left: 0; right: 0; bottom: 5px; height: 0; transition: height 650ms var(--ease-out); z-index: 1; }
  .liquid.has::before { /* surface highlight with a gentle wave */
    content: ''; position: absolute; left: -4%; right: -4%; top: -3px; height: 7px; border-radius: 50%;
    background: color-mix(in srgb, var(--top) 70%, #fff); opacity: .9;
    animation: wave 3.2s ease-in-out infinite;
  }
  .liquid::after { /* inner depth */
