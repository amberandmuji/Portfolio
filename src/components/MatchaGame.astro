  }
  .chip svg { width: 16px; height: 16px; flex: none; }
  .chip:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 6px 14px rgb(12 12 14 / .08); border-color: color-mix(in srgb, var(--c) 60%, rgb(12 12 14 / .15)); }
  .chip:active:not(:disabled) { transform: scale(.95); }
  .chip:disabled { opacity: .4; cursor: not-allowed; }
  .chip.pop { animation: pop 380ms var(--ease-spring); }
  @keyframes pop { 40% { transform: scale(1.1); } }

  .actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }
  .btn {
    height: 38px; padding: 0 18px; border-radius: 999px; border: 1px solid rgb(12 12 14 / .1); background: transparent;
    font-size: 0.875rem; color: var(--ink); cursor: pointer;
    transition: transform var(--dur-1) var(--ease-out), background var(--dur-1), opacity var(--dur-1);
  }
  .btn:hover:not(:disabled) { background: var(--surface); }
  .btn:active:not(:disabled) { transform: scale(.96); }
