---
// "Make yourself a drink!" — a small physics-flavoured drink builder.
// Liquids settle by density (honey at the bottom, tea floating on milk), boba sinks,
// ice rests on the bottom of an empty cup and floats once there is liquid,
// cold foam sits on the surface. Serving blends the layers into a gradient and
// adds the drink to the drink wall.
import { site } from '../data/site';

type Kind = 'liquid' | 'ice' | 'boba' | 'foam';
const ingredients: { id: string; label: string; color: string; kind: Kind; density?: number }[] = [
  { id: 'ice', label: 'Ice', color: '#dbeef6', kind: 'ice' },
  { id: 'milk', label: 'Milk', color: '#f7f3ea', kind: 'liquid', density: 1.035 },
  { id: 'oat', label: 'Oat milk', color: '#ecdcbc', kind: 'liquid', density: 1.03 },
  { id: 'matcha', label: 'Matcha', color: '#6f9a3c', kind: 'liquid', density: 1.01 },
  { id: 'hojicha', label: 'Hojicha', color: '#9a6540', kind: 'liquid', density: 1.0 },
  { id: 'honey', label: 'Honey', color: '#eeaa2e', kind: 'liquid', density: 1.42 },
  { id: 'strawberry', label: 'Strawberry', color: '#e2667c', kind: 'liquid', density: 1.15 },
  { id: 'mango', label: 'Mango', color: '#f4ae35', kind: 'liquid', density: 1.12 },
  { id: 'boba', label: 'Boba', color: '#3a2820', kind: 'boba' },
  { id: 'foam', label: 'Cold foam', color: '#fffaf1', kind: 'foam' },
];
const wall = site.drinkWall;
---
<section class="game" aria-labelledby="game-title">
  <div class="panel">
    <div class="stage">
      <div class="glass" data-glass>
        <div class="lid" aria-hidden="true"></div>
        <div class="straw" aria-hidden="true"></div>
        <div class="inside" aria-hidden="true">
          <div class="liquid" data-liquid><div class="blend" data-blend></div></div>
          <div class="pearls" data-pearls></div>
          <div class="cubes" data-cubes></div>
          <div class="foam" data-foam></div>
          <div class="stream" data-stream></div>
        </div>
        <svg class="outline" viewBox="0 0 150 230" aria-hidden="true">
          <defs>
            <linearGradient id="glass-shine" x1="0" x2="1">
              <stop offset="0" stop-color="#fff" stop-opacity="0" />
              <stop offset=".12" stop-color="#fff" stop-opacity=".75" />
              <stop offset=".2" stop-color="#fff" stop-opacity="0" />
              <stop offset=".8" stop-color="#fff" stop-opacity="0" />
              <stop offset=".88" stop-color="#fff" stop-opacity=".35" />
              <stop offset="1" stop-color="#fff" stop-opacity="0" />
            </linearGradient>
          </defs>
          <path d="M3 7 L147 7 L133.5 224 Q133 228 129 228 L21 228 Q17 228 16.5 224 Z" fill="url(#glass-shine)" />
          <path d="M3 7 L147 7 L133.5 224 Q133 228 129 228 L21 228 Q17 228 16.5 224 Z" fill="none" stroke="#9aa6ae" stroke-opacity=".7" stroke-width="2.2" stroke-linejoin="round" />
          <ellipse cx="75" cy="7" rx="72" ry="4.5" fill="none" stroke="#9aa6ae" stroke-opacity=".55" stroke-width="1.6" />
        </svg>
      </div>
      <div class="coaster" aria-hidden="true"></div>
    </div>

    <div class="copy">
      <h2 id="game-title">Make yourself a drink!</h2>
      <p class="sub">Tap ingredients to pour them in, then serve it.</p>

      <div class="build" data-build>
        <div class="chips" role="group" aria-label="Ingredients">
          {ingredients.map((g) => (
            <button class="chip" type="button" data-add={g.id} style={`--c:${g.color}`}>
              {g.kind === 'liquid' && (
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1.5C8 1.5 3 7.3 3 10.3a5 5 0 0 0 10 0C13 7.3 8 1.5 8 1.5Z" fill="var(--c)" stroke="rgb(0 0 0 / .18)" /><path d="M5.6 10.6a2.4 2.4 0 0 0 1.6 2.2" fill="none" stroke="#fff" stroke-opacity=".8" stroke-linecap="round" /></svg>
              )}
              {g.kind === 'ice' && (
                <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="2.5" y="3" width="11" height="10" rx="2.6" fill="#e6f4fa" stroke="#7fa2b8" /><path d="M5 5.6h3" stroke="#fff" stroke-width="1.4" stroke-linecap="round" /></svg>
              )}
              {g.kind === 'boba' && (
                <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="5" cy="10.5" r="2.6" fill="#3a2820" /><circle cx="10.6" cy="10.5" r="2.6" fill="#4a3329" /><circle cx="7.8" cy="6" r="2.6" fill="#2e1f19" /></svg>
              )}
              {g.kind === 'foam' && (
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 12h8.5a2.8 2.8 0 0 0 .3-5.6A3.6 3.6 0 0 0 6 5.6 3.2 3.2 0 0 0 4 12Z" fill="#fffaf1" stroke="rgb(0 0 0 / .22)" /></svg>
              )}
              {g.label}
            </button>
          ))}
        </div>
        <div class="actions">
          <button class="btn primary" type="button" data-serve disabled>Serve it</button>
          <button class="btn" type="button" data-undo disabled>Undo</button>
          <button class="btn" type="button" data-reset disabled>Start over</button>
        </div>
      </div>

      <div class="result" data-result hidden>
        <span class="eyebrow">Order up</span>
        <strong class="name" data-drink-name></strong>
        <div class="swatch-bar" data-swatch></div>
        <p class="facts" data-facts></p>
        <div class="actions">
          <button class="btn primary" type="button" data-share>Add to the drink wall</button>
          <button class="btn" type="button" data-again>Make another</button>
        </div>
      </div>

      <p class="status" aria-live="polite" data-status>Your cup is empty.</p>
    </div>
  </div>

  <div class="wall">
    <div class="wall-head">
      <h3 data-wall-title>The drink wall</h3>
      <span class="wall-sub" data-wall-sub></span>
    </div>
    <ol class="wall-grid" data-wall></ol>
  </div>
</section>

<script define:vars={{ ingredients, wall }}>
  const root = document.getElementById('game-title').closest('.game');
  const $ = (s) => root.querySelector(s);
  const byId = Object.fromEntries(ingredients.map((g) => [g.id, g]));
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Geometry (px, measured from the inside bottom of the glass)
  const FLOOR = 5;         // glass base thickness
  const UNIT = 26;         // height of one pour
  const CAP = 196;         // usable height
  const CUBE_H = 25, CUBE_ROW = 21, PER_ROW = 3, ICE_MAX = 6;
  const PEARL_ROW = 10, PEARLS_PER_TAP = 6, PEARL_MAX = 18;
  const FOAM_TAP = 15, FOAM_MAX = 30;
  const DISPLACE = 6;      // liquid rise per submerged cube

  let cup = [];

  const liquidEl = $('[data-liquid]'), blendEl = $('[data-blend]'), pearlsEl = $('[data-pearls]');
  const cubesEl = $('[data-cubes]'), foamEl = $('[data-foam]'), streamEl = $('[data-stream]');
  const status = $('[data-status]'), glass = $('[data-glass]');

  const count = (id) => cup.filter((c) => c === id).length;

  function model() {
    const liquids = {};
    for (const id of cup) if (byId[id].kind === 'liquid') liquids[id] = (liquids[id] || 0) + 1;
    const ice = Math.min(count('ice'), ICE_MAX);
    const pearls = Math.min(count('boba') * PEARLS_PER_TAP, PEARL_MAX);
    const foam = Math.min(count('foam') * FOAM_TAP, FOAM_MAX);
    const units = Object.values(liquids).reduce((a, b) => a + b, 0);
    const bobaH = pearls ? Math.ceil(pearls / 6) * PEARL_ROW + 3 : 0;
    const vol = units * UNIT;
    // Floating ice pushes the level up a little
    const liquidH = vol ? Math.min(vol + ice * DISPLACE, CAP) : 0;
    // Heaviest at the bottom
    const order = Object.keys(liquids).sort((a, b) => byId[b].density - byId[a].density);
    const scale = vol ? liquidH / vol : 0;
    const layers = order.map((id) => ({ id, c: byId[id].color, h: liquids[id] * UNIT * scale }));

    const cubes = [];
    const rows = Math.ceil(ice / PER_ROW);
    for (let i = 0; i < ice; i++) {
      const r = Math.floor(i / PER_ROW), col = i % PER_ROW;
      let bottom;
      if (liquidH === 0) bottom = Math.max(0, bobaH - 6) + r * CUBE_ROW;              // resting on the floor (or on the boba)
      else bottom = Math.max(bobaH * 0.5, liquidH - CUBE_H * 0.72 - (rows - 1 - r) * CUBE_ROW); // floating, ~72% submerged
      cubes.push({ bottom, left: [14, 39, 62][col] + ((i * 7) % 5) - 2, rot: ((i * 37) % 30) - 15, float: liquidH > 0 });
    }
    const iceTop = cubes.length ? Math.max(...cubes.map((c) => c.bottom)) + CUBE_H : 0;
    const foamBottom = liquidH ? liquidH : cubes.length ? iceTop - 10 : Math.max(0, bobaH - 4);
    return { layers, liquidH, units, pearls, bobaH, cubes, foam, foamBottom, ice };
  }

  function layeredGradient(layers) {
    if (!layers.length) return 'none';
    const stops = []; let y = 0;
    layers.forEach((l, i) => {
      const top = y + l.h;
      const soft = i < layers.length - 1 ? 4 : 0;
      stops.push(`${l.c} ${Math.max(0, y + (i ? 4 : 0))}px`, `${l.c} ${Math.max(0, top - soft)}px`);
      y = top;
    });
    return `linear-gradient(to top, ${stops.join(', ')})`;
  }
  function blendedGradient(layers, H, dir = 'to top') {
    if (!layers.length) return 'none';
    if (layers.length === 1) return layers[0].c;
    let y = 0; const stops = [];
    layers.forEach((l) => { stops.push(`${l.c} ${((y + l.h / 2) / H * 100).toFixed(1)}%`); y += l.h; });
    return `linear-gradient(${dir}, ${stops.join(', ')})`;
  }

  function sync(listEl, n, make) {
    while (listEl.children.length > n) listEl.lastElementChild.remove();
    while (listEl.children.length < n) {
      const el = make(listEl.children.length);
      if (!reduce) el.classList.add('enter');
      listEl.appendChild(el);
    }
  }

  function render(added) {
    const m = model();
    // Liquid
    liquidEl.style.height = m.liquidH + 'px';
    liquidEl.style.background = layeredGradient(m.layers);
    liquidEl.style.setProperty('--top', m.layers.length ? m.layers[m.layers.length - 1].c : 'transparent');
    blendEl.style.background = blendedGradient(m.layers, m.liquidH);
    liquidEl.classList.toggle('has', m.liquidH > 0);

    // Boba: sinks to the floor
    sync(pearlsEl, m.pearls, (i) => { const b = document.createElement('i'); b.style.setProperty('--d', `${(i % 6) * 35}ms`); return b; });
    [...pearlsEl.children].forEach((b, i) => {
      const r = Math.floor(i / 6), col = i % 6;
      b.style.left = `${19 + col * 11 + (r % 2) * 5}%`;
      b.style.bottom = `${FLOOR + r * PEARL_ROW}px`;
    });

    // Ice
    sync(cubesEl, m.cubes.length, (i) => {
      const c = document.createElement('i'); c.style.setProperty('--d', `${i * 40}ms`);
      c.appendChild(document.createElement('span')); return c;
    });
    [...cubesEl.children].forEach((c, i) => {
      const d = m.cubes[i];
      c.style.left = d.left + '%';
      c.style.bottom = FLOOR + d.bottom + 'px';
      c.firstChild.style.setProperty('--r', d.rot + 'deg');
      c.classList.toggle('float', d.float);
    });

    // Foam: rests on whatever is highest
    foamEl.style.height = m.foam + 'px';
    foamEl.style.bottom = FLOOR + m.foamBottom + 'px';
    foamEl.classList.toggle('on', m.foam > 0);

    // Pour stream for liquids and foam
    if (added && !reduce && (byId[added].kind === 'liquid' || byId[added].kind === 'foam')) {
      streamEl.style.setProperty('--c', byId[added].color);
      streamEl.style.height = `calc(100% - ${FLOOR + m.liquidH}px)`;
      streamEl.classList.remove('go'); void streamEl.offsetWidth; streamEl.classList.add('go');
    }

    const n = cup.length;
    const full = m.units * UNIT >= CAP;
    $('[data-serve]').disabled = n === 0;
    $('[data-undo]').disabled = n === 0;
    $('[data-reset]').disabled = n === 0;
    root.querySelectorAll('[data-add]').forEach((b) => {
      const g = byId[b.dataset.add];
      b.disabled = (g.kind === 'liquid' && full) || (g.kind === 'ice' && m.ice >= ICE_MAX) ||
        (g.kind === 'boba' && m.pearls >= PEARL_MAX) || (g.kind === 'foam' && m.foam >= FOAM_MAX);
    });
    return m;
  }

  function explain(id, before, after) {
    const g = byId[id];
    if (g.kind === 'ice') return after.liquidH ? 'The ice floats. It is lighter than the drink.' : 'Ice sits on the bottom of an empty cup.';
    if (g.kind === 'boba') return 'Boba sinks straight to the bottom.';
    if (g.kind === 'foam') return after.liquidH ? 'Cold foam floats on the surface.' : 'Foam settles in. It floats once you add a drink.';
    if (before.liquidH === 0 && after.ice) return 'The ice lifts off the bottom and floats.';
    if (after.units * UNIT >= CAP) return 'Your cup is full. Serve it!';
    if (id === 'honey') return 'Honey is the heaviest, so it sinks below everything else.';
    if (id === 'strawberry' || id === 'mango') return 'Fruit purée is dense and settles low.';
    if ((id === 'milk' || id === 'oat') && (count('matcha') || count('hojicha'))) return 'Milk is denser than tea, so it slips underneath.';
    if ((id === 'matcha' || id === 'hojicha') && (count('milk') || count('oat'))) return 'The tea is lighter than milk and floats on top.';
    return `Poured in ${g.label.toLowerCase()}.`;
  }

  function nameDrink() {
    const has = (x) => cup.includes(x);
    const liquids = cup.filter((c) => byId[c].kind === 'liquid');
    if (!liquids.length) {
      if (has('boba')) return 'Just boba? Bold choice.';
      if (has('ice')) return 'A cup of ice. Very hydrating.';
      return 'A cloud of cold foam';
    }
    if (liquids.length === count('honey')) return `${has('ice') ? 'Iced ' : ''}Straight Honey`;
    const fruit = ['strawberry', 'mango'].filter(has).map((f) => f[0].toUpperCase() + f.slice(1));
    const tea = has('matcha') && has('hojicha') ? 'Matcha-Hojicha' : has('matcha') ? 'Matcha' : has('hojicha') ? 'Hojicha' : '';
    const milk = has('oat') ? 'Oat ' : '';
    const isLatte = has('milk') || has('oat');
    let base = tea ? `${milk}${tea}${isLatte ? ' Latte' : ''}` : isLatte ? `${fruit.length ? '' : 'Plain '}${milk}Milk` : 'Mystery Brew';
    if (!tea && !isLatte && fruit.length) base = `${fruit.join('-')} Juice`;
    else if (fruit.length) base = `${fruit.join('-')} ${base}`;
    if (has('honey')) base = `Honey ${base}`;
    if (has('ice')) base = `Iced ${base}`;
    const extras = [has('boba') && 'Boba', has('foam') && 'Cold Foam'].filter(Boolean);
    return extras.length ? `${base} with ${extras.join(' & ')}` : base;
  }

  function snapshot() {
    const m = model();
    const total = m.liquidH || 1;
    return {
      name: nameDrink(),
      layers: m.layers.map((l) => ({ c: l.c, h: +(l.h / total).toFixed(3) })),
      boba: Math.min(m.pearls, 18), ice: m.ice, foam: m.foam > 0,
    };
  }

  // ---------- Drink wall ----------
  const LS_KEY = 'drink-wall-v1';
  const remote = !!(wall && wall.url && wall.anonKey);
  const HOUSE = [
    { name: 'Iced Strawberry Matcha Latte', layers: [{ c: '#e2667c', h: 0.3 }, { c: '#f7f3ea', h: 0.4 }, { c: '#6f9a3c', h: 0.3 }], boba: 0, ice: 3, foam: false, house: true },
    { name: 'Honey Oat Hojicha Latte with Boba', layers: [{ c: '#eeaa2e', h: 0.15 }, { c: '#ecdcbc', h: 0.5 }, { c: '#9a6540', h: 0.35 }], boba: 12, ice: 0, foam: false, house: true },
    { name: 'Iced Mango Matcha Latte with Cold Foam', layers: [{ c: '#f4ae35', h: 0.3 }, { c: '#f7f3ea', h: 0.35 }, { c: '#6f9a3c', h: 0.35 }], boba: 0, ice: 3, foam: true, house: true },
  ];

  const safeColor = (c) => (/^#[0-9a-f]{6}$/i.test(c) ? c : '#cccccc');
  function clean(d) {
    if (!d || typeof d !== 'object') return null;
    const layers = Array.isArray(d.layers) ? d.layers.slice(0, 10).map((l) => ({ c: safeColor(l && l.c), h: Math.max(0, Math.min(1, +(l && l.h) || 0)) })) : [];
    return {
      name: String(d.name || 'Mystery drink').slice(0, 60), layers,
      boba: Math.max(0, Math.min(18, d.boba | 0)), ice: Math.max(0, Math.min(6, d.ice | 0)), foam: !!d.foam,
      t: d.created_at ? Date.parse(d.created_at) : d.t || null, house: !!d.house, mine: !!d.mine,
    };
  }
  function readLocal() { try { return JSON.parse(localStorage.getItem(LS_KEY) || '[]'); } catch { return []; } }
  function writeLocal(list) { try { localStorage.setItem(LS_KEY, JSON.stringify(list.slice(0, 12))); } catch {} }

  async function loadWall() {
    let others = [];
    let reached = false;
    if (remote) {
      try {
        const r = await fetch(`${wall.url}/rest/v1/drinks?select=name,layers,boba,ice,foam,created_at&order=created_at.desc&limit=18`, {
          headers: { apikey: wall.anonKey, Authorization: `Bearer ${wall.anonKey}` },
        });
        if (r.ok) { others = await r.json(); reached = true; }
      } catch {}
    }
    const mine = readLocal().map((d) => ({ ...d, mine: true }));
    let list = reached ? others : mine;
    if (list.length < 4) list = [...list, ...HOUSE];
    $('[data-wall-title]').textContent = reached ? 'Drinks other visitors made' : 'The drink wall';
    $('[data-wall-sub]').textContent = reached ? 'Newest first' : 'Your drinks and a few house recipes';
    drawWall(list.map(clean).filter(Boolean).slice(0, 18));
  }

  function ago(t) {
    if (!t) return '';
    const s = Math.max(0, (Date.now() - t) / 1000);
    if (s < 60) return 'just now';
    if (s < 3600) return `${Math.floor(s / 60)} min ago`;
    if (s < 86400) return `${Math.floor(s / 3600)} h ago`;
    return `${Math.floor(s / 86400)} d ago`;
  }

  function miniCup(d) {
    const li = document.createElement('li');
    const cupEl = document.createElement('div'); cupEl.className = 'mini';
    const fill = document.createElement('div'); fill.className = 'mini-fill';
    let y = 0; const stops = [];
    d.layers.forEach((l) => { stops.push(`${l.c} ${((y + l.h / 2) * 100).toFixed(0)}%`); y += l.h; });
    fill.style.background = d.layers.length > 1 ? `linear-gradient(to top, ${stops.join(', ')})` : (d.layers[0] ? d.layers[0].c : 'transparent');
    fill.style.height = d.layers.length ? '78%' : '0';
    cupEl.appendChild(fill);
    for (let i = 0; i < Math.min(d.boba, 12); i++) {
      const p = document.createElement('i'); p.className = 'mini-pearl';
      p.style.left = `${22 + (i % 6) * 9 + (Math.floor(i / 6) % 2) * 4}%`; p.style.bottom = `${3 + Math.floor(i / 6) * 5}px`;
      cupEl.appendChild(p);
    }
    for (let i = 0; i < Math.min(d.ice, 3); i++) {
      const c = document.createElement('i'); c.className = 'mini-ice';
      c.style.left = `${18 + i * 22}%`; c.style.bottom = d.layers.length ? '64%' : `${3 + i * 3}px`; c.style.transform = `rotate(${i * 11 - 10}deg)`;
      cupEl.appendChild(c);
    }
    if (d.foam) { const f = document.createElement('i'); f.className = 'mini-foam'; f.style.bottom = d.layers.length ? '76%' : '3px'; cupEl.appendChild(f); }
    const name = document.createElement('span'); name.className = 'mini-name'; name.textContent = d.name;
    const meta = document.createElement('span'); meta.className = 'mini-meta';
    meta.textContent = d.house ? 'House recipe' : d.mine ? `You · ${ago(d.t)}` : ago(d.t);
    li.append(cupEl, name, meta);
    return li;
  }
  function drawWall(list) {
    const ol = $('[data-wall]'); ol.textContent = '';
    list.forEach((d, i) => { const li = miniCup(d); li.style.setProperty('--i', i); ol.appendChild(li); });
  }

  async function share() {
    const d = snapshot();
    const btn = $('[data-share]');
    btn.disabled = true;
    writeLocal([{ ...d, t: Date.now() }, ...readLocal()]);
    if (remote) {
      try {
        await fetch(`${wall.url}/rest/v1/drinks`, {
          method: 'POST',
          headers: { apikey: wall.anonKey, Authorization: `Bearer ${wall.anonKey}`, 'Content-Type': 'application/json', Prefer: 'return=minimal' },
          body: JSON.stringify({ name: d.name, layers: d.layers, boba: d.boba, ice: d.ice, foam: d.foam }),
        });
      } catch {}
    }
    btn.textContent = 'On the wall';
    status.textContent = 'Added to the drink wall.';
    await loadWall();
    const first = root.querySelector('.wall-grid li');
    if (first) first.classList.add('fresh');
  }

  // ---------- Events ----------
  root.addEventListener('click', (e) => {
    const b = e.target.closest('button');
    if (!b || b.disabled) return;
    if (b.dataset.add) {
      const before = model();
      cup.push(b.dataset.add);
      b.classList.remove('pop'); void b.offsetWidth; b.classList.add('pop');
      const after = render(b.dataset.add);
      status.textContent = explain(b.dataset.add, before, after);
    } else if ('undo' in b.dataset) { cup.pop(); render(); status.textContent = cup.length ? 'Took the last pour back out.' : 'Your cup is empty.'; }
    else if ('reset' in b.dataset) { cup = []; render(); status.textContent = 'Your cup is empty.'; }
    else if ('serve' in b.dataset) {
      const d = snapshot();
      const m = model();
      glass.classList.add('is-served');
      $('[data-build]').hidden = true;
      $('[data-result]').hidden = false;
      $('[data-drink-name]').textContent = d.name;
      const sw = blendedGradient(m.layers, m.liquidH, 'to right');
      $('[data-swatch]').style.background = sw === 'none' ? 'repeating-linear-gradient(45deg, #eee 0 6px, #f6f6f6 6px 12px)' : sw;
      const facts = [];
      if (m.layers.length) facts.push(`${m.layers.length} ${m.layers.length === 1 ? 'layer' : 'layers'} swirled together`);
      if (m.ice) facts.push(`${m.ice} ice cube${m.ice > 1 ? 's' : ''}`);
      if (m.pearls) facts.push('boba on the bottom');
      if (m.foam) facts.push('cold foam on top');
      $('[data-facts]').textContent = facts.join(' · ');
      const sh = $('[data-share]'); sh.disabled = false; sh.textContent = 'Add to the drink wall';
      status.textContent = m.layers.length > 1 ? 'Served! The layers blend as you stir.' : 'Served!';
    } else if ('share' in b.dataset) { share(); }
    else if ('again' in b.dataset) {
      cup = [];
      glass.classList.remove('is-served');
      $('[data-build]').hidden = false;
      $('[data-result]').hidden = true;
      render();
      status.textContent = 'Your cup is empty.';
    }
  });

  render();
  loadWall();
</script>

<style>
  /* Full-width grey band directly above the footer */
