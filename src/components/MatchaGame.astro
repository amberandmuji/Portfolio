  .cubes :global(i span::after) { content: ''; position: absolute; left: 4px; top: 3px; width: 9px; height: 3px; border-radius: 2px; background: rgb(255 255 255 / .9); transform: rotate(-12deg); }
  .cubes :global(i.float span) { animation: bob 2.6s ease-in-out infinite; }
