  .cubes :global(i.enter) { animation: plunk 620ms var(--ease-spring) both; animation-delay: var(--d); }
  @keyframes plunk { from { transform: translateY(-220px); opacity: 0; } 35% { opacity: 1; } }
  @keyframes bob { 0%, 100% { transform: rotate(var(--r)) translateY(0); } 50% { transform: rotate(calc(var(--r) + 3deg)) translateY(-2px); } }

  .foam {
    position: absolute; left: 0; right: 0; height: 0; z-index: 4; opacity: 0;
    background:
      radial-gradient(circle at 20% 30%, rgb(255 255 255 / .9) 0 3px, transparent 3.5px),
      radial-gradient(circle at 55% 60%, rgb(255 255 255 / .8) 0 2.5px, transparent 3px),
      radial-gradient(circle at 80% 35%, rgb(255 255 255 / .9) 0 2px, transparent 2.5px),
      linear-gradient(180deg, #fffdf8, #f2e8d5);
    background-size: 22px 14px, 18px 12px, 26px 16px, 100% 100%;
    border-radius: 40% 40% 0 0 / 6px 6px 0 0;
    transition: height 600ms var(--ease-out), bottom 650ms var(--ease-out), opacity 300ms;
  }
  .foam.on { opacity: 1; }

  .stream {
    position: absolute; left: 50%; top: 0; width: 7px; margin-left: -3.5px; height: 0; z-index: 5;
    background: var(--c); border-radius: 0 0 4px 4px; transform-origin: top; opacity: 0;
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / .06);
  }
  .stream.go { animation: pour 560ms ease-in both; }
  @keyframes pour { 0% { transform: scaleY(0); opacity: 1; } 55% { transform: scaleY(1); opacity: 1; } 100% { transform: scaleY(1) translateY(30px); opacity: 0; } }

  .straw, .lid { position: absolute; opacity: 0; pointer-events: none; }
  .straw {
    left: 92px; top: -46px; width: 11px; height: 200px; border-radius: 6px; z-index: 0;
    background: repeating-linear-gradient(180deg, var(--accent) 0 14px, #fff 14px 22px);
    box-shadow: inset -2px 0 0 rgb(0 0 0 / .08);
    transform: rotate(10deg) translateY(-20px); transform-origin: bottom center;
    transition: opacity 300ms, transform 600ms var(--ease-spring) 150ms;
  }
  .lid {
    left: 0; right: 0; top: -14px; height: 22px; z-index: 7;
    border-radius: 50% 50% 8px 8px / 100% 100% 8px 8px;
    background: linear-gradient(180deg, rgb(255 255 255 / .75), rgb(225 233 238 / .7));
    box-shadow: inset 0 0 0 1.5px rgb(154 166 174 / .7);
    transform: translateY(-14px);
    transition: opacity 300ms, transform 500ms var(--ease-spring);
  }
  .is-served .straw { opacity: 1; transform: rotate(10deg); }
  .is-served .lid { opacity: 1; transform: none; }
