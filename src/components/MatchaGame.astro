    background: linear-gradient(90deg, rgb(0 0 0 / .08), transparent 22%, transparent 78%, rgb(0 0 0 / .1));
  }
  .blend { position: absolute; inset: 0; opacity: 0; transition: opacity 1.4s var(--ease-out) .15s; }
  .is-served .blend { opacity: 1; }
  @keyframes wave { 50% { transform: translateY(1px) scaleX(.97); } }

  .pearls { position: absolute; inset: 0; z-index: 2; }
  .pearls :global(i) {
    position: absolute; width: 13px; height: 13px; margin-left: -6px; border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #7a5a4a, #2a1a14 70%);
    box-shadow: 0 1px 1px rgb(0 0 0 / .25);
    transition: bottom 500ms var(--ease-out), left 500ms var(--ease-out);
  }
