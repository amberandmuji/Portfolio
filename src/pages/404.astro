---
import Base from '../layouts/Base.astro';
---
<Base title="Not found — Amber's portfolio">
  <section class="container nf">
    <h1>This page wandered off.</h1>
    <p>Maybe it went to get a matcha. Let's head back.</p>
    <a href="/">← Back home</a>
  </section>
</Base>

<style>
  .nf { padding-block: clamp(96px, 16vw, 200px); text-align: center; display: flex; flex-direction: column; align-items: center; gap: 16px; }
  h1 { font-size: clamp(36px, 6vw, 64px); }
  p { color: var(--ink-2); }
  a { margin-top: 8px; padding: 12px 20px; border-radius: 999px; background: var(--ink); color: var(--bg); font-weight: 600; }
</style>
