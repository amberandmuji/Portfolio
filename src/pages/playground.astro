---
import Base from '../layouts/Base.astro';
import PlaygroundList from '../components/PlaygroundList.astro';
import WorkCard from '../components/WorkCard.astro';
import { playground, passion } from '../data/site';
---
<Base title="Playground — Amber's portfolio" description="Vibe coding projects Amber built with AI tools.">
  <section class="edge pg-page">
    <h1 class="section-title">Vibe Coding Playground</h1>
    <p class="lede">I use AI to explore the ideas in my head, just for fun.</p>
    <PlaygroundList cards={playground} />
  </section>

  <section class="edge past">
    <h2 class="section-title" data-reveal>Past Projects</h2>
    <div class="grid two" data-stagger>
      {passion.map((c) => <WorkCard card={c} cursor="View case study" />)}
    </div>
  </section>
</Base>

<style>
  .edge { padding-inline: var(--edge); }
  .pg-page { padding-top: clamp(48px, 8vw, 120px); }
  .lede { margin-top: 12px; font-size: var(--fs-bio); letter-spacing: -0.02em; line-height: 1.5; color: var(--muted); }
  /* gap under the intro is larger than the gap between projects (clamp(64px, 9vw, 128px)) */
  .pg-page .lede { margin-bottom: clamp(88px, 11vw, 160px); }
  .past { margin-top: clamp(96px, 12vw, 172px); }
  .past .section-title { margin-bottom: 22px; }
  .grid { display: grid; gap: 50px 32px; }
  .grid.two { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (max-width: 809px) { .grid.two { grid-template-columns: minmax(0, 1fr); gap: 40px; } }
</style>
