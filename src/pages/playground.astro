---
import Base from '../layouts/Base.astro';
import Playground from '../components/Playground.astro';
import { playground } from '../data/site';
---
<Base title="Playground — Amber's portfolio" description="Vibe coding projects Amber built with AI tools.">
  <section class="edge pg-page">
    <h1 class="section-title">Vibe Coding Playground</h1>
    <p class="lede">Small things I build with AI tools to try ideas fast. Click one to play with it.</p>
    <Playground cards={playground} />
  </section>
</Base>

<style>
  .edge { padding-inline: var(--edge); }
  .pg-page { padding-top: clamp(48px, 8vw, 120px); }
  .lede { margin: 12px 0 40px; max-width: 640px; font-size: var(--fs-bio); letter-spacing: -0.02em; line-height: 1.5; color: var(--muted); }
</style>
