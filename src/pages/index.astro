---
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import MatchaGame from '../components/MatchaGame.astro';
import Playground from '../components/Playground.astro';
import { selectedWorks, playground, passion, testimonials } from '../data/site';
---
<Base>
  <section class="hero container">
    <h1 class="hello t-name">
      <span class="line"><span class="w">Hello!</span></span>
      <span class="line"><span class="w">I'm</span> <span class="w">Amber</span></span>
    </h1>
    <p class="intro t-bio">
      Product Designer with an engineering background, shipping across B2B and B2C including fintech and healthcare with
      data-driven design and AI tools.
    </p>
    <a href="#projects" class="scroll-cue" aria-label="Scroll to work">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M12 5v14M6 13l6 6 6-6"/></svg>
    </a>
  </section>

  <section id="projects" class="section container">
    <h2 class="section-title" data-reveal>Selected Works</h2>
    <div class="grid two" data-stagger>
      {selectedWorks.map((c) => <WorkCard card={c} />)}
    </div>
  </section>

  <section class="section container">
    <h2 class="section-title" data-reveal>Vibe Coding Playground</h2>
    <Playground cards={playground} />
  </section>

  <section class="section container">
    <h2 class="section-title" data-reveal>Passion Projects</h2>
    <div class="grid two" data-stagger>
      {passion.map((c) => <WorkCard card={c} size="md" />)}
    </div>
  </section>

  <section class="section container">
    <h2 class="section-title" data-reveal>What other people said about me</h2>
    <div class="grid two" data-stagger>
      {testimonials.map((t) => (
        <figure class="quote lift" data-reveal>
          <blockquote class="t-body">{t.quote}</blockquote>
          <figcaption>
            <img src={t.photo} alt="" width="56" height="56" loading="lazy" />
            <span><span class="t-small">{t.name}</span><span class="t-sub role">{t.role}</span></span>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <MatchaGame />
</Base>

<style>
  .hero { padding-block: clamp(56px, 9vw, 128px) clamp(32px, 5vw, 72px); position: relative; }
  .hello { display: flex; flex-direction: column; }
  .line { display: block; overflow: hidden; padding-bottom: .08em; }
  .w { display: inline-block; }
  .intro { max-width: 640px; margin-top: 20px; }
  .scroll-cue { display: inline-grid; place-items: center; width: 44px; height: 44px; margin-top: 40px; border-radius: 50%; border: 1px solid var(--line); color: var(--ink-2); transition: color var(--dur-1), border-color var(--dur-1); }
  .scroll-cue:hover { color: var(--ink); border-color: var(--muted); }

  .grid { display: grid; gap: clamp(28px, 3.5vw, 48px) clamp(20px, 2.5vw, 32px); }
  .grid.two { grid-template-columns: repeat(2, minmax(0, 1fr)); }

  .quote { margin: 0; display: flex; flex-direction: column; justify-content: space-between; gap: 24px; padding: clamp(22px, 3vw, 32px); border-radius: var(--radius-l); background: var(--surface); border: 1px solid var(--line); }
  blockquote { margin: 0; color: var(--ink); }
  blockquote::before { content: '“'; display: block; font-size: 3.5rem; line-height: .6; color: var(--accent); margin-bottom: 8px; font-variation-settings: 'opsz' 32; }
  figcaption { display: flex; align-items: center; gap: 14px; }
  figcaption img { width: 56px; height: 56px; border-radius: 50%; object-fit: cover; background: var(--img-bg); }
  figcaption > span { display: flex; flex-direction: column; line-height: 1.3; }
  .role { font-size: var(--fs-body); }

  /* Phone (Framer < 810) */
  @media (max-width: 809px) {
    .grid.two { grid-template-columns: 1fr; }
  }
</style>
