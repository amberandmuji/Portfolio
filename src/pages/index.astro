---
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import MatchaGame from '../components/MatchaGame.astro';
import Playground from '../components/Playground.astro';
import Terminal from '../components/Terminal.astro';
import { selectedWorks, playground, passion, testimonials } from '../data/site';
---
<Base>
  <!-- Full-width layout with 36px page edges, measured from the live Framer page at 1440px -->
  <section class="hero edge">
    <div class="hero-text">
      <h1 class="hello t-name">
        <span>Hello!</span>
        <span>I'm Amber</span>
      </h1>
      <p class="intro">
        Product Designer with an engineering background, shipping across B2B and B2C including fintech and healthcare with
        data-driven design and AI tools.
      </p>
    </div>
    <div class="hero-term"><Terminal /></div>
  </section>

  <section id="projects" class="block edge">
    <h2 class="section-title" data-reveal>Selected Works</h2>
    <div class="grid two" data-stagger>
      {selectedWorks.map((c) => <WorkCard card={c} cursor="View case study" />)}
    </div>
  </section>

  <section class="block edge">
    <h2 class="section-title" data-reveal>Vibe Coding Playground</h2>
    <Playground cards={playground} />
  </section>

  <section class="block edge">
    <h2 class="section-title" data-reveal>Passion Projects</h2>
    <div class="grid two" data-stagger>
      {passion.map((c) => <WorkCard card={c} cursor="View case study" />)}
    </div>
  </section>

  <section class="block edge">
    <h2 class="section-title" data-reveal>What other people said about me</h2>
    <div class="grid two quotes" data-stagger>
      {testimonials.map((t) => (
        <figure class="quote" data-reveal>
          <figcaption>
            <img src={t.photo} alt="" width="50" height="50" loading="lazy" />
            <span><span class="name">{t.name}</span><span class="role">{t.role}</span></span>
          </figcaption>
          <blockquote>{t.quote}</blockquote>
        </figure>
      ))}
    </div>
  </section>

  <MatchaGame />
</Base>

<style>
  .edge { padding-inline: var(--edge); }
  .hero { padding-block: clamp(40px, 6vw, 96px) 0; display: grid; grid-template-columns: minmax(0, 1fr) clamp(320px, 32vw, 460px); align-items: center; gap: clamp(32px, 5vw, 96px); }
  .hero-term { justify-self: end; width: 100%; }
  @media (max-width: 809px) {
    .hero { grid-template-columns: minmax(0, 1fr); gap: 24px; }
    .hero-term { justify-self: stretch; max-width: 460px; }
  }
  .hello { display: flex; flex-direction: column; gap: 19px; }
  .intro { max-width: 958px; margin-top: 20px; font-size: var(--fs-bio); letter-spacing: -0.02em; line-height: 1.5; color: var(--ink); }

  .block { margin-top: clamp(96px, 12vw, 172px); }
  #projects { margin-top: clamp(96px, 13vw, 192px); }
  .section-title { margin-bottom: 22px; }

  .grid { display: grid; gap: 50px 32px; }
  .grid.two { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .quotes { margin-top: 80px; gap: 32px; }

  .quote { margin: 0; padding: 30px; border-radius: 20px; background: var(--surface); }
  figcaption { display: flex; align-items: center; gap: 15px; }
  figcaption img { width: 50px; height: 50px; border-radius: 50%; object-fit: cover; background: var(--img-bg); }
  figcaption > span { display: flex; flex-direction: column; }
  .name { font-size: var(--fs-small); line-height: 1.4; }
  .role { color: var(--muted); }
  blockquote { margin: 30px 0 0; color: var(--ink); }

  /* Phone (Framer < 810) */
  @media (max-width: 809px) {
    .grid.two { grid-template-columns: 1fr; gap: 40px; }
    .quotes { margin-top: 32px; gap: 16px; }
    .quote { padding: 22px; }
  }
</style>
