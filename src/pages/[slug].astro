---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';

export async function getStaticPaths() {
  const entries = await getCollection('work');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---
<Base title={`${d.title.split(':')[0]} — Amber's portfolio`} description={d.description}>
  <article class="case">
    <div class="container">
      {d.toc && (
        <nav class="toc" data-toc aria-label="On this page">
          {d.toc.map((t) => <a href={`#${t.id}`}>{t.label}</a>)}
        </nav>
      )}

      <header class="head" id="overview">
        <div class="hero-img" data-reveal>
          <img src={d.hero} alt="" width="1441" height="762" fetchpriority="high" />
        </div>
        <h1 class="t-section" data-reveal>{d.title}</h1>
        <dl class="meta" data-stagger>
          {d.meta.map((m) => (
            <div data-reveal><dt>{m.label}</dt><dd>{m.value}</dd></div>
          ))}
        </dl>
      </header>

      <div class="prose">
        <Content />
      </div>
      <script is:inline>
        document.querySelectorAll('.prose > *').forEach(function (el) { el.setAttribute('data-reveal', ''); });
      </script>

      <a class="next lift" href={`/${d.next.slug}`} data-reveal>
        <span class="eyebrow">Next project</span>
        <div class="tags">{d.next.tags.map((t) => <span class="tag">{t}</span>)}</div>
        <span class="next-org">{d.next.eyebrow}</span>
        <strong>{d.next.title}</strong>
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </article>
</Base>

<style>
  .case { padding-top: clamp(24px, 4vw, 48px); }
  .container { position: relative; }

  /* Sticky section nav (desktop), horizontal scroller (tablet/phone) */
  .toc { position: sticky; top: 84px; z-index: 10; display: flex; gap: 4px; width: max-content; max-width: 100%; margin: 0 auto 28px; padding: 5px; border-radius: 999px; background: color-mix(in srgb, var(--surface) 85%, transparent); backdrop-filter: blur(12px); border: 1px solid var(--line); overflow-x: auto; scrollbar-width: none; transition: top var(--dur-2) var(--ease-out); }
  .toc a { padding: 6px 14px; border-radius: 999px; font-size: var(--fs-body); color: rgb(51 51 51); white-space: nowrap; transition: background var(--dur-1), color var(--dur-1); }
  .toc a:hover { color: var(--ink); }
  .toc a:global(.on) { background: var(--nav-selected); color: var(--surface); }
  :global(.hdr.hide) ~ main .toc { top: 12px; }

  .head { max-width: 1040px; margin-inline: auto; }
  .hero-img { border-radius: var(--radius-l); overflow: hidden; background: var(--img-bg); box-shadow: var(--shadow-1); }
  .hero-img img { width: 100%; height: auto; }
  h1 { margin-top: clamp(28px, 4vw, 48px); max-width: 900px; }
  .meta { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 20px 32px; margin: clamp(24px, 3vw, 40px) 0 0; padding-top: 24px; border-top: 1px solid var(--line); }
  .meta dt { font-size: var(--fs-sub); letter-spacing: var(--ls-sub); line-height: 1.4; color: var(--muted); }
  .meta dd { margin: 6px 0 0; white-space: pre-line; font-size: var(--fs-body); }

  .next { position: relative; display: flex; flex-direction: column; gap: 10px; max-width: 820px; margin: var(--section-gap) auto 0; padding: clamp(24px, 4vw, 40px); border-radius: var(--radius-l); background: var(--surface); border: 1px solid var(--line); }
  .next-org { color: var(--muted); font-size: var(--fs-sub); letter-spacing: var(--ls-sub); }
  .next strong { font-weight: 400; font-size: var(--fs-section); letter-spacing: -0.04em; line-height: 1.4; padding-right: 48px; }
  .arrow { position: absolute; right: clamp(24px, 4vw, 40px); bottom: clamp(24px, 4vw, 40px); font-size: 28px; transition: transform var(--dur-2) var(--ease-spring); }
  .next:hover .arrow { transform: translateX(6px); }

  @media (max-width: 809px) { .toc { top: 72px; } }
</style>

<style is:global>
  /* Long-form case study body */
  .prose { max-width: 1040px; margin: var(--section-gap) auto 0; }
  .prose > * + * { margin-top: 20px; }
  .prose h2 { font-size: var(--fs-sub); letter-spacing: var(--ls-sub); line-height: 1.4; color: var(--accent); margin-top: calc(var(--section-gap) * .8); }
  .prose h3 { font-size: var(--fs-section); letter-spacing: -0.04em; line-height: 1.4; margin-top: clamp(48px, 6vw, 80px); max-width: 860px; }
  .prose h2 + h3 { margin-top: 14px; }
  .prose h4 { font-size: var(--fs-small); line-height: 1.4; margin-top: 40px; }
  .prose p, .prose li { color: var(--ink); font-size: var(--fs-body); letter-spacing: var(--ls-body); line-height: 1.5; max-width: 760px; }
  .prose strong { font-weight: 600; }
  .prose a { color: var(--link); }
  .prose a:hover { color: var(--link-hover); text-decoration: underline; }
  .prose img, .prose video { width: 100%; border-radius: var(--radius-m); background: var(--img-bg); }
  .prose img { box-shadow: var(--shadow-1); }
  .prose .lede { font-size: var(--fs-bio); letter-spacing: -0.02em; line-height: var(--lh-bio); color: var(--ink-2); max-width: 900px; font-variation-settings: 'opsz' 32; }

  .prose .pair { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .prose .phone { max-width: 320px; margin-inline: auto; }
  .prose .phone img { border-radius: 28px; }

  .prose .metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; }
  .prose .metrics > div { padding: 20px 24px; border-radius: var(--radius-m); background: var(--surface); border: 1px solid var(--line); }
  .prose .metrics b { display: block; font-weight: 400; font-size: var(--fs-metric); line-height: 1.6; letter-spacing: -0.02em; color: var(--ink); font-variant-numeric: tabular-nums; }
  .prose .metrics b.up::after { content: ' ▲'; font-size: .35em; vertical-align: middle; color: var(--green); }
  .prose .metrics span { display: block; color: var(--muted); font-size: var(--fs-sub); letter-spacing: var(--ls-sub); line-height: 1.4; }

  .prose .cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .prose .cards.three { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .prose .cards > div { padding: 22px 24px; border-radius: var(--radius-m); background: var(--surface); border: 1px solid var(--line); transition: transform var(--dur-2) var(--ease-out), box-shadow var(--dur-2); }
  .prose .cards > div:hover { transform: translateY(-3px); box-shadow: var(--shadow-1); }
  .prose .cards h5 { font-size: var(--fs-small); line-height: 1.4; margin-bottom: 8px; }
  .prose .cards p { margin: 0; }
  .prose .cards ul { margin: 0; padding-left: 18px; }

  .prose .feature { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(20px, 3vw, 40px); align-items: center; padding: clamp(20px, 3vw, 32px); border-radius: var(--radius-l); background: var(--surface); border: 1px solid var(--line); }
  .prose .feature .eyebrow { display: block; margin-bottom: 6px; }
  .prose .feature h5 { font-size: var(--fs-sub); letter-spacing: var(--ls-sub); line-height: 1.4; color: var(--muted); }
  .prose .feature p.what { font-size: var(--fs-small); line-height: 1.4; letter-spacing: 0; margin-top: 8px; }
  .prose .feature p.solved { margin-top: 14px; padding: 12px 14px; border-radius: var(--radius-s); background: var(--slate-1); }
  .prose .feature video { box-shadow: var(--shadow-1); }

  .prose .caption { color: var(--muted); text-align: center; max-width: none; }

  @media (max-width: 809px) {
    .prose .pair, .prose .cards, .prose .cards.three, .prose .feature { grid-template-columns: 1fr; }
  }
</style>
