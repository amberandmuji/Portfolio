---
// Inter (variable, with optical-size axis → Inter Display at opsz 32), self-hosted
import '@fontsource-variable/inter/opsz.css';
import '@fontsource-variable/inter/opsz-italic.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props { title?: string; description?: string; image?: string }
const { title = site.title, description = site.description, image = site.ogImage } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en" data-resume={site.resume} data-base={import.meta.env.BASE_URL}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="robots" content="max-image-preview:large" />
    <!-- Muji, pixel-art Pomeranian -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />


    <!-- Mark JS available so reveal animations only hide content when they can show it again -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <script is:inline>
      // Every page opens at the very top: no browser scroll restoration on reload or back/forward.
      // Links with a #section (like "Work") still jump to that section.
      (function () {
        if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
        var toTop = function () {
          if (location.hash) return;
          var el = document.documentElement, prev = el.style.scrollBehavior;
          el.style.scrollBehavior = 'auto';
          window.scrollTo(0, 0);
          el.style.scrollBehavior = prev;
        };
        toTop();
        document.addEventListener('DOMContentLoaded', toTop);
        window.addEventListener('pageshow', toTop);
      })();
    </script>

    <!-- Google Analytics 4 (gtag.js), loaded only when site.ga4 is set -->
    {site.ga4 && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${site.ga4}`}></script>}
    {site.ga4 && (
      <script is:inline define:vars={{ ga4: site.ga4 }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', ga4);
      </script>
    )}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <div class="cursor-label" data-cursor-label aria-hidden="true"></div>
    <script>
      import '../scripts/motion.ts';
      import '../scripts/analytics.ts';
    </script>
  </body>
</html>

<style is:global>
  /* Cross-page fade, like Framer's page transition — no JS needed */
  @view-transition { navigation: auto; }
  ::view-transition-old(root) { animation: 220ms var(--ease-out) both vt-out; }
  ::view-transition-new(root) { animation: 380ms var(--ease-out) both vt-in; }
  @keyframes vt-out { to { opacity: 0; } }
  @keyframes vt-in { from { opacity: 0; transform: translateY(8px); } }

  .skip { position: absolute; left: -9999px; }
  .skip:focus { left: 16px; top: 16px; z-index: 100; background: var(--surface); padding: 8px 14px; border-radius: 8px; }
</style>
